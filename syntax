#include <stdio.sf>

typedef struct {
    uint32 x;
    int32 y;
} Vector2;

typedef struct {
    Vector2 pos;
    bool active;
} Player;

 
func (p *Player) move(dx int32, dy int32) {
    p->pos.x = p->pos.x + (uint32)dx;
    p->pos.y = p->pos.y + dy;
}

func (p *Player) isAlive() bool {
    return p->active && (p->pos.y >= 0);
}

func (v Vector2) magnitude() uint32 {
    return (v.x * v.x) + (uint32)(v.y * v.y);
}

func calculate_mask(flags uint32, mask uint32) uint32 {
    uint32 inverted = ~mask;          // Bitwise NOT prefix
    uint32 combined = flags & mask;   // Bitwise AND
    return combined | (flags ^ inverted); // Bitwise OR, XOR
}

func evaluate_condition(a int32, b int32) bool {
    if (a != b && !(a <= 0)) {
        return (a > b) || (b == 100);
    }
    return false;
}

